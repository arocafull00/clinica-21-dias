---
import { MAP_URL, WHATSAPP_BOOKING_URL } from "../lib/seo";

---

<section id="contacto" class="relative isolate overflow-hidden border-t border-ink-line py-20 lg:py-28">
  <div class="blob -left-[14%] -bottom-[40%] h-[30rem] w-[36rem] rounded-[50%] bg-lavender-200 md:-left-[8%] md:-bottom-[55%]" aria-hidden="true"></div>
  <div class="wrap grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center">
    <div data-reveal>
      <p class="eyebrow">Contacto</p>
      <h2 class="display mt-7 text-6xl md:text-7xl text-ink">Reserva tu cita.</h2>
      <a href={WHATSAPP_BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-dark mt-10" data-clic="reserva-contacto">
        Escríbenos por WhatsApp
      </a>
    </div>

    <div class="grid gap-10 text-[0.9375rem] leading-relaxed text-ink sm:grid-cols-2 sm:gap-0 sm:divide-x sm:divide-ink-line" data-reveal style="--i: 1">
      <address class="not-italic space-y-4 sm:pr-10">
        <a href={MAP_URL} target="_blank" rel="noopener noreferrer" class="block hover:text-primary-600 transition-colors">
          Calle San Valeriano 20A<br />Torrent, Valencia
        </a>
        <a href="tel:+34640205738" data-clic="telefono-contacto" class="block hover:text-primary-600 transition-colors">+34 640 20 57 38</a>
        <a href="mailto:clinica@21diaspsicoeducacion.es" data-clic="email-contacto" class="block break-all hover:text-primary-600 transition-colors">clinica@21diaspsicoeducacion.es</a>
        <a href="https://www.instagram.com/21diaspsicoeducacion/" target="_blank" rel="noopener noreferrer" class="block hover:text-primary-600 transition-colors">@21diaspsicoeducacion</a>
      </address>
      <dl class="space-y-5 sm:pl-10">
        <div>
          <dt class="text-ink-soft">Lunes, miércoles y jueves</dt>
          <dd class="font-semibold">9:30 – 14:00</dd>
        </div>
        <div>
          <dt class="text-ink-soft">De lunes a viernes</dt>
          <dd class="font-semibold">16:00 – 21:00</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
