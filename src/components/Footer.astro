---
import { services } from '../data/services';

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-ink text-white/70">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
    <a href="/" class="font-serif text-2xl leading-[0.95] text-white self-start">
      21 Días<br />Psicoeducación
    </a>
    <nav aria-label="Servicios">
      <ul class="grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <li>
              <a href={service.url} class="hover:text-white transition-colors">{service.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="wrap flex flex-col gap-2 border-t border-white/10 py-6 text-xs sm:flex-row sm:justify-between">
    <p>&copy; {currentYear} 21 Días Psicoeducación. Clínica de Psicología en Torrent.</p>
    <a href="https://adrianrocafull.es/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
      Web desarrollada por Adrian Rocafull
    </a>
  </div>
</footer>
