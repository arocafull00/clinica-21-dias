---
import { Image } from 'astro:assets';
import {
	AUDIENCIA_LABEL,
	formatoDuracion,
	formatoPrecio,
	rangoDuracion,
	urlContenido,
	type Contenido,
} from '../../data/formacion';

interface Props {
	item: Contenido;
	index: number;
}

const { item, index } = Astro.props;
const href = urlContenido(item);
const audiencia = item.audiencia.map((a) => AUDIENCIA_LABEL[a]).join(' y ');
---

<li
	class="video-card"
	data-card
	data-slug={item.slug}
	data-tema={item.tema}
	data-duracion={rangoDuracion(item.minutos)}
	data-formato={item.formato}
	data-minutos={item.minutos}
	data-valoracion={item.valoracion}
	data-fecha={item.publicado}
>
	<a href={href} class="group block" aria-label={`${item.titulo}, con ${item.ponente}`}>
		<div class="thumb relative aspect-video overflow-hidden rounded-[1.25rem] bg-lavender-100">
			<Image
				src={item.miniatura}
				alt=""
				widths={[400, 640, 800]}
				sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
				loading={index < 3 ? 'eager' : 'lazy'}
				class="thumb-img h-full w-full object-cover"
			/>
			<div class="absolute left-3 top-3">
				{item.gratis ? (
					<span class="rounded-full bg-white/90 px-3 py-1 text-[0.75rem] font-semibold text-primary-700">Gratis</span>
				) : (
					<span class="inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-[0.75rem] font-semibold text-ink">
						<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="4" y="11" width="16" height="10" rx="2"></rect>
							<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
						</svg>
						<span data-badge-precio>{formatoPrecio(item.precio)}</span>
					</span>
				)}
			</div>
			<span class="play absolute bottom-3 right-3 grid h-11 w-11 place-items-center rounded-full bg-white/90 text-ink">
				<svg class="ml-0.5 h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"></path>
				</svg>
			</span>
		</div>
	</a>

	<div class="mt-4 flex items-center gap-3">
		<span class="rounded-full bg-primary-800 px-3 py-1 text-[0.8125rem] font-semibold text-white">{formatoDuracion(item.minutos)}</span>
		<span class="inline-flex items-center gap-1 text-[0.8125rem] font-medium text-ink-soft">
			<svg class="h-3.5 w-3.5 text-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5Z"></path>
			</svg>
			<span><span class="sr-only">Valoración </span>{item.valoracion.toFixed(1)}</span>
		</span>
		<span class="text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-ink-soft">{item.formato}</span>
		<button
			type="button"
			class="fav-btn ml-auto grid h-10 w-10 place-items-center rounded-full text-ink transition-colors hover:bg-white"
			data-fav={item.slug}
			aria-pressed="false"
			aria-label={`Guardar «${item.titulo}» en favoritos`}
		>
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 20.5s-7.5-4.6-9.2-9.4C1.6 7.6 4 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.7 1.1-1.6 2.7-2.7 4.7-2.7 3.3 0 5.7 3.1 4.5 6.6-1.7 4.8-9.2 9.4-9.2 9.4Z"></path>
			</svg>
		</button>
	</div>

	<a href={href} class="mt-2 block">
		<h3 class="font-serif text-[1.6rem] leading-[1.1] text-ink transition-colors hover:text-primary-700">{item.titulo}</h3>
	</a>
	<p class="mt-3 text-[0.875rem] font-medium text-ink">Con {item.ponente}</p>
	<p class="mt-1 text-[0.8125rem] text-ink-soft">Para {audiencia.toLowerCase()}</p>
</li>

<style>
	.thumb :global(.thumb-img),
	.play {
		transition: scale 700ms var(--ease-out-expo);
	}

	@media (hover: hover) {
		.group:hover :global(.thumb-img) {
			scale: 1.04;
		}

		.group:hover .play {
			scale: 1.08;
		}
	}

	.fav-btn[aria-pressed='true'] svg {
		fill: #56734f;
		stroke: #56734f;
	}
</style>
