---
const testimonials = [
  {
    name: "María G.",
    text: "La atención en 21 días ha sido excepcional. Me han ayudado a superar momentos muy difíciles con profesionalidad y cercanía.",
  },
  {
    name: "Carlos P.",
    text: "Gracias a la terapia he conseguido herramientas muy valiosas para gestionar mi ansiedad. Totalmente recomendable.",
  },
  {
    name: "Laura S.",
    text: "Hicieron una evaluación súper completa a mi hijo de 9 años, con un informe con todas las pruebas y el diagnóstico. Estamos encantados con todo el equipo.",
  },
];
---

<section id="testimonios" class="py-20 lg:py-28">
  <div class="wrap">
    <h2 class="sr-only">Lo que nos cuentan</h2>
    <div class="grid gap-12 md:grid-cols-3 md:gap-0 md:divide-x md:divide-ink-line">
      {
        testimonials.map((testimonial, index) => (
          <figure data-reveal style={`--i: ${index}`} class="md:px-10 md:first:pl-0 md:last:pr-0">
            <blockquote class="font-serif text-[1.65rem] leading-[1.2] text-ink">
              “{testimonial.text}”
            </blockquote>
            <figcaption class="mt-6 text-sm font-semibold text-ink-soft">{testimonial.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
