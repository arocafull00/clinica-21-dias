---
import GlowImage from './GlowImage.astro';
import img2 from '../assets/clinica/2.jpeg';
import img3 from '../assets/clinica/3.jpeg';
import img4 from '../assets/clinica/4.jpeg';
import img6 from '../assets/clinica/6.jpeg';
import img7 from '../assets/clinica/7.jpeg';
import imgFisio from '../assets/clinica/fisio.png';

const photos = [
	{ src: img4, alt: 'Mostrador de recepción blanco con lámpara', title: 'Recepción' },
	{ src: img6, alt: 'Sala de logopedia con camilla y decoración lúdica', title: 'Logopedia' },
	{ src: img2, alt: 'Sala de terapia grupal con mesa y sillas', title: 'Terapia grupal' },
	{ src: imgFisio, alt: 'Sala de fisioterapia con camilla', title: 'Fisioterapia' },
	{ src: img3, alt: 'Pasillo y área de recepción', title: 'Entrada' },
];
---

<section id="el-centro" class="relative isolate overflow-hidden py-20 lg:py-28">
	<div class="grid items-center gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
		<div class="pl-edge pr-[var(--gutter)] lg:pr-0" data-reveal>
			<p class="eyebrow">Nuestro espacio</p>
			<h2 class="display mt-7 text-5xl md:text-[3.6rem] text-ink">
				Un lugar pensado para sentirte cómodo.
			</h2>
			<p class="mt-6 max-w-sm text-[0.9375rem] leading-relaxed text-ink-soft">
				Contamos con un espacio acogedor y adaptado para acompañarte en cada etapa.
			</p>
		</div>

		<div class="relative h-[20rem] sm:h-[26rem] lg:h-[28rem] ml-[var(--gutter)] lg:ml-0" data-reveal style="--i: 1">
			<div class="blob -right-[10%] -bottom-[16%] h-[62%] w-[34%] rounded-[60%_0_0_50%/55%_0_0_45%] bg-primary-300" aria-hidden="true"></div>
			<div class="photo-glow absolute inset-0 right-[4%] overflow-hidden rounded-[30%_2rem_14%_2rem/46%_2rem_30%_2rem]">
				<GlowImage
					src={img7}
					alt="Sala de terapia infantil con mesa redonda y escritorio"
					widths={[640, 960, 1400]}
					sizes="(max-width: 1024px) 95vw, 58vw"
				/>
			</div>
		</div>
	</div>

	<div class="gallery-strip wrap mt-16 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 lg:mt-20 lg:grid lg:grid-cols-5 lg:overflow-visible">
		{
			photos.map((photo, index) => (
				<figure class="w-[62vw] max-w-[16rem] shrink-0 snap-start lg:w-auto lg:max-w-none" data-reveal style={`--i: ${index}`}>
					<div class="photo-glow relative aspect-[4/5] overflow-hidden rounded-[1.75rem] [--glow-size:9rem]">
						<GlowImage
							src={photo.src}
							alt={photo.alt}
							widths={[320, 480]}
							sizes="(max-width: 1024px) 62vw, 20vw"
						/>
					</div>
					<figcaption class="mt-3 text-[0.8125rem] text-ink-soft">{photo.title}</figcaption>
				</figure>
			))
		}
	</div>
</section>
