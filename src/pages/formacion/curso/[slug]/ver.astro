---
import Layout from '../../../../layouts/Layout.astro';
import Footer from '../../../../components/Footer.astro';
import VideoCard from '../../../../components/formacion/VideoCard.astro';
import { contenidos, formatoDuracion, urlContenido } from '../../../../data/formacion';
import { SITE_NAME } from '../../../../lib/seo';

export function getStaticPaths() {
	return contenidos.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const minutosLeccion = Math.max(2, Math.round(item.minutos / item.lecciones.length));
const relacionados = contenidos.filter((c) => c.slug !== item.slug).slice(0, 3);
---

<Layout title={`${item.titulo} · Reproductor | ${SITE_NAME}`} description={item.descripcion} noindex includeBusinessJsonLd={false}>
	<main id="contenido-principal">
		<section class="bg-ink pt-28 pb-14 text-white lg:pt-32 lg:pb-20">
			<div class="wrap">
				<a href={urlContenido(item)} class="inline-flex items-center gap-2 text-[0.875rem] font-medium text-white/70 transition-colors hover:text-white">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 12H4M10 6l-6 6 6 6"></path>
					</svg>
					Volver a la ficha
				</a>

				<div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] lg:gap-10">
					<div>
						<div class="overflow-hidden rounded-[1.5rem] bg-black">
							<video
								class="aspect-video w-full object-cover"
								autoplay
								muted
								loop
								playsinline
								controls
								src={item.video}
								data-video
							></video>
						</div>
						<p class="mt-6 text-[0.6875rem] font-semibold uppercase tracking-[0.22em] text-white/60">
							{item.formato} · {item.tema} · <span data-leccion-actual>Lección 1</span>
						</p>
						<h1 class="mt-3 font-serif text-4xl leading-tight sm:text-5xl">{item.titulo}</h1>
						<div class="mt-4 flex items-center gap-3 text-[0.9375rem] text-white/80">
							<span class="grid h-8 w-8 place-items-center rounded-full bg-lavender-200 text-[0.75rem] font-semibold text-ink" aria-hidden="true">CF</span>
							Con {item.ponente}
						</div>
						<p class="mt-5 max-w-2xl text-[1rem] leading-relaxed text-white/70">{item.descripcion}</p>
					</div>

					<aside class="self-start rounded-[1.5rem] bg-white/5 p-3" aria-label="Lecciones">
						<p class="px-3 pt-2 pb-3 text-[0.6875rem] font-semibold uppercase tracking-[0.22em] text-white/60">
							{item.lecciones.length} {item.lecciones.length === 1 ? 'lección' : 'lecciones'} · {formatoDuracion(item.minutos)}
						</p>
						<ol class="grid gap-1">
							{
								item.lecciones.map((leccion, i) => (
									<li>
										<button
											type="button"
											class="leccion flex w-full items-center gap-4 rounded-xl px-3 py-3 text-left transition-colors hover:bg-white/10"
											data-leccion={i + 1}
											aria-current={i === 0 ? 'true' : undefined}
										>
											<span class="leccion-num grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/10 text-[0.8125rem] font-semibold">{i + 1}</span>
											<span class="flex-1">
												<span class="block text-[0.9375rem] leading-snug text-white">{leccion}</span>
												<span class="block text-[0.8125rem] text-white/50">{minutosLeccion} min</span>
											</span>
										</button>
									</li>
								))
							}
						</ol>
					</aside>
				</div>
			</div>
		</section>

		<section class="py-20 lg:py-24">
			<div class="wrap">
				<p class="eyebrow">Sigue aprendiendo</p>
				<h2 class="display mt-6 text-4xl md:text-5xl text-ink">Siguientes contenidos</h2>
				<ul class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
					{relacionados.map((c, i) => <VideoCard item={c} index={i} />)}
				</ul>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	// Lecciones de demostración: todas usan el mismo vídeo; al cambiar se reinicia.
	function initReproductor() {
		const video = document.querySelector<HTMLVideoElement>('[data-video]');
		const actual = document.querySelector<HTMLElement>('[data-leccion-actual]');
		const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-leccion]')];
		if (!video || !botones.length) return;

		botones.forEach((btn) =>
			btn.addEventListener('click', () => {
				botones.forEach((b) => b.removeAttribute('aria-current'));
				btn.setAttribute('aria-current', 'true');
				if (actual) actual.textContent = `Lección ${btn.dataset.leccion}`;
				video.currentTime = 0;
				video.play().catch(() => {});
				video.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}),
		);
	}

	document.addEventListener('astro:page-load', initReproductor);
</script>

<style>
	.leccion[aria-current='true'] {
		background: rgb(255 255 255 / 0.12);
	}

	.leccion[aria-current='true'] .leccion-num {
		background: #acc0a4;
		color: #1d1d1b;
	}
</style>
