---
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import VideoCard from '../../../components/formacion/VideoCard.astro';
import PagoModal from '../../../components/formacion/PagoModal.astro';
import {
	ACCESO_VITALICIO,
	ACCESO_STORAGE_KEY,
	AUDIENCIA_LABEL,
	contenidos,
	formatoDuracion,
	urlReproductor,
} from '../../../data/formacion';
import { SITE_NAME } from '../../../lib/seo';

export function getStaticPaths() {
	return contenidos.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const ver = urlReproductor(item);
const precio = `${ACCESO_VITALICIO.precio} ${ACCESO_VITALICIO.moneda}`;
const audiencia = item.audiencia.map((a) => AUDIENCIA_LABEL[a]);
const incluye = [
	`${item.lecciones.length} ${item.lecciones.length === 1 ? 'lección' : 'lecciones'} en vídeo · ${formatoDuracion(item.minutos)}`,
	...(item.gratis ? ['Acceso libre, sin registro'] : ACCESO_VITALICIO.incluye),
];
const relacionados = [
	...contenidos.filter((c) => c.slug !== item.slug && c.tema === item.tema),
	...contenidos.filter((c) => c.slug !== item.slug && c.tema !== item.tema),
].slice(0, 3);
---

<Layout title={`${item.titulo} · Formación | ${SITE_NAME}`} description={item.descripcion} includeBusinessJsonLd={false}>
	<main id="contenido-principal">
		<section class="relative isolate overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24">
			<div class="blob -left-[12%] top-[20%] h-[22rem] w-[28rem] rounded-[50%_50%_45%_55%/55%_45%_55%_45%] bg-primary-200" aria-hidden="true"></div>
			<div class="blob -right-[8%] -bottom-[20%] h-[18rem] w-[24rem] rounded-full bg-lavender-200" aria-hidden="true"></div>

			<div class="wrap grid items-center gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
				<div class="hero-enter">
					<a href="/formacion" class="eyebrow hover:text-primary-600 transition-colors" style="--i: 0">Formación · {item.tema}</a>
					<a
						href={item.gratis ? ver : '#'}
						class="group relative mt-7 block overflow-hidden rounded-[1.75rem]"
						style="--i: 1"
						data-cta-ver
						{...(item.gratis ? {} : { 'data-abrir-pago': '' })}
						aria-label={item.gratis ? `Ver «${item.titulo}»` : `Obtener acceso a «${item.titulo}»`}
					>
						<Image src={item.miniatura} alt="" widths={[640, 960, 1280]} sizes="(max-width: 1024px) 92vw, 58vw" loading="eager" class="aspect-video w-full object-cover" />
						<span class="absolute inset-0 grid place-items-center bg-ink/0 transition-colors group-hover:bg-ink/10">
							<span class="grid h-20 w-20 place-items-center rounded-full bg-white/90 text-ink shadow-lg transition-transform group-hover:scale-105">
								<svg class="ml-1 h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"></path>
								</svg>
							</span>
						</span>
					</a>
				</div>

				<div class="hero-enter">
					<p class="text-[0.6875rem] font-semibold uppercase tracking-[0.22em] text-ink-soft" style="--i: 1">{item.formato} · Para {audiencia.join(' y ').toLowerCase()}</p>
					<h1 class="display mt-4 text-[2.75rem] sm:text-5xl xl:text-6xl text-ink" style="--i: 2">{item.titulo}</h1>
					<p class="mt-5 text-base md:text-[1.0625rem] leading-relaxed text-ink-soft" style="--i: 3">{item.descripcion}</p>

					<div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-[0.875rem]" style="--i: 4">
						<span class="rounded-full bg-primary-800 px-3 py-1 font-semibold text-white">{formatoDuracion(item.minutos)}</span>
						<span class="inline-flex items-center gap-1 font-medium text-ink">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8L12 2.5Z"></path>
							</svg>
							<span><span class="sr-only">Valoración </span>{item.valoracion.toFixed(1)}</span>
						</span>
						<span class="flex items-center gap-2 font-medium text-ink">
							<span class="grid h-8 w-8 place-items-center rounded-full bg-lavender-200 text-[0.75rem] font-semibold" aria-hidden="true">CF</span>
							Con {item.ponente}
						</span>
					</div>

					<div class="mt-8 border-t border-ink-line pt-7" style="--i: 5">
						{
							item.gratis ? (
								<>
									<p class="font-serif text-3xl text-ink">Gratis</p>
									<a href={ver} class="btn mt-5">Ver ahora</a>
								</>
							) : (
								<>
									<div data-cta-pago>
										<p class="font-serif text-3xl text-ink">
											{precio} <span class="font-sans text-[0.875rem] text-ink-soft">pago único</span>
										</p>
										<p class="mt-1 text-[0.875rem] text-ink-soft">Acceso vitalicio a este y a todos los contenidos.</p>
										<button type="button" class="btn mt-5" data-abrir-pago data-clic="formacion-obtener-acceso">Obtener acceso</button>
									</div>
									<div class="hidden" data-cta-acceso>
										<p class="font-serif text-3xl text-ink">Ya tienes acceso</p>
										<a href={ver} class="btn mt-5">Ver ahora</a>
									</div>
								</>
							)
						}
					</div>
				</div>
			</div>
		</section>

		<section class="wrap grid gap-14 pb-20 lg:grid-cols-2 lg:gap-20 lg:pb-28">
			<div data-reveal>
				<p class="eyebrow">Qué incluye</p>
				<ul class="mt-7 border-t border-ink-line">
					{
						incluye.map((linea) => (
							<li class="flex items-start gap-4 border-b border-ink-line py-4 text-[1rem] text-ink">
								<svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="m5 12.5 4.5 4.5L19 7.5"></path>
								</svg>
								{linea}
							</li>
						))
					}
				</ul>
			</div>

			<div data-reveal style="--i: 1">
				<p class="eyebrow">Temario</p>
				<ol class="mt-7 border-t border-ink-line">
					{
						item.lecciones.map((leccion, i) => (
							<li class="flex items-center gap-5 border-b border-ink-line py-4">
								<span class="w-6 font-serif text-2xl text-ink-soft">{i + 1}</span>
								<span class="flex-1 text-[1rem] text-ink">{leccion}</span>
								{!item.gratis && (
									<svg class="h-4 w-4 shrink-0 text-ink-soft" data-candado viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-label="Bloqueado">
										<rect x="4" y="11" width="16" height="10" rx="2"></rect>
										<path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
									</svg>
								)}
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="border-t border-ink-line py-20 lg:py-24">
			<div class="wrap">
				<p class="eyebrow">Sigue aprendiendo</p>
				<h2 class="display mt-6 text-4xl md:text-5xl text-ink">Más contenidos</h2>
				<ul class="mt-12 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
					{relacionados.map((c, i) => <VideoCard item={c} index={i} />)}
				</ul>
			</div>
		</section>
	</main>

	{!item.gratis && <PagoModal destino={ver} concepto="Acceso vitalicio a toda la formación" />}
	<Footer />
	<script define:vars={{ key: ACCESO_STORAGE_KEY, gratis: item.gratis, ver }}>
		// Si ya se "pagó" (acceso simulado), se muestra el botón para ver directamente.
		const aplicarAcceso = () => {
			if (gratis) return;
			let tiene = false;
			try {
				tiene = localStorage.getItem(key) === 'true';
			} catch {}
			if (!tiene) return;
			document.querySelector('[data-cta-pago]')?.classList.add('hidden');
			document.querySelector('[data-cta-acceso]')?.classList.remove('hidden');
			document.querySelectorAll('[data-candado]').forEach((el) => el.remove());
			const portada = document.querySelector('[data-cta-ver]');
			if (portada) {
				portada.removeAttribute('data-abrir-pago');
				portada.setAttribute('href', ver);
			}
		};
		aplicarAcceso();
	</script>
</Layout>
